{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockCount Server",
  "version": "0.1.0",
  "identifier": "com.dreamer.stockcount.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StockCount · 服务管理器",
        "width": 1160,
        "height": 780,
        "minWidth": 930,
        "minHeight": 620,
        "backgroundColor": "#F5F7FB"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/StockCount.Api"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
