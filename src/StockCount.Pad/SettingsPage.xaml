<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockCount.Pad.SettingsPage"
             NavigationPage.HasNavigationBar="False"
             Title="连接与设备设置" BackgroundColor="{StaticResource PageBackground}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" BackgroundColor="White" Padding="8,6,12,6"
          ColumnDefinitions="Auto,*" HeightRequest="60">
      <Button Text="‹" Style="{StaticResource IconButton}"
              Clicked="Back_Clicked"/>
      <Label Grid.Column="1" Text="连接与设备设置"
             Style="{StaticResource PageTitle}" Margin="6,0,0,0"/>
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="14,14,14,16" Spacing="13">
        <Border BackgroundColor="White" Stroke="#E3E9F1"
                StrokeShape="RoundRectangle 12" Padding="15">
          <VerticalStackLayout Spacing="12">
            <Label Text="◫  API 连接" Style="{StaticResource SectionTitle}"/>
            <Label Text="服务端 API 地址" FontSize="12" FontAttributes="Bold"
                   TextColor="#536581"/>
            <Border Stroke="#DCE4EF" StrokeShape="RoundRectangle 9"
                    Padding="8,0">
              <Entry x:Name="ApiAddress" Keyboard="Url"
                     Placeholder="192.168.1.1:5080"
                     FontSize="14" BackgroundColor="Transparent"
                     HeightRequest="48"/>
            </Border>
            <Label Text="输入内网 IP:端口即可，自动补全 http://。PDA 通过 API 访问数据库，不直接连接 SQL Server。"
                   Style="{StaticResource SecondaryText}" LineBreakMode="WordWrap"/>

            <Button Text="旧版密钥设置（可选）" Style="{StaticResource SecondaryAction}"
                    Clicked="ToggleLegacyKey_Clicked"/>
            <VerticalStackLayout x:Name="LegacyKeyPanel" IsVisible="False" Spacing="8">
            <Label Text="旧版服务密钥（可选）" FontSize="12"
                   FontAttributes="Bold" TextColor="#536581"/>
            <Border Stroke="#DCE4EF" StrokeShape="RoundRectangle 9"
                    Padding="8,0">
              <Entry x:Name="DeviceKey" IsPassword="True"
                     Placeholder="内网免密模式无需填写"
                     BackgroundColor="Transparent" FontSize="14"
                     HeightRequest="48"/>
            </Border>
            <Label x:Name="DeviceKeyStatus" Text="仅旧版密钥认证模式需要填写"
                   Style="{StaticResource SecondaryText}"
                   LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
            <Button x:Name="TestConnectionButton" Text="◉  测试连接" Style="{StaticResource SecondaryAction}"
                    Clicked="Test_Clicked"/>
            <Label x:Name="ConnectionResult" Text="检测当前输入的地址，无需先保存。依次检查 TCP、API 和数据库；不会写入盘点数据。"
                   FontSize="12" TextColor="#72829C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="White" Stroke="#E3E9F1"
                StrokeShape="RoundRectangle 12" Padding="15">
          <VerticalStackLayout Spacing="12">
            <Label Text="◇  帐套选择" Style="{StaticResource SectionTitle}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button x:Name="TestEnvironmentButton" Grid.Column="0"
                      Text="测试 · XTEST" Style="{StaticResource SecondaryAction}"
                      Clicked="SelectTest_Clicked"/>
              <Button x:Name="ProductionEnvironmentButton" Grid.Column="1"
                      Text="正式 · COB" Style="{StaticResource SecondaryAction}"
                      Clicked="SelectProduction_Clicked"/>
            </Grid>
            <Label Text="切换帐套后重新选择盘点单，库位和箱码不能跨帐套沿用。"
                   Style="{StaticResource SecondaryText}"
                   LineBreakMode="WordWrap"/>
            <Border x:Name="ProductionWarning" IsVisible="False"
                    BackgroundColor="#FFF5E6" Stroke="#F3DEBA"
                    StrokeShape="RoundRectangle 10" Padding="11">
              <Label Text="⚠ 当前选择正式帐套 COB。提交将依据后端正式帐套写入授权，直接操作生产盘点明细。"
                     FontSize="12" TextColor="#9B5C11"
                     LineBreakMode="WordWrap"/>
            </Border>
          </VerticalStackLayout>
        </Border>

        <!-- Live PDA diagnostic: never render or store the decoded QR contents. -->
        <Border BackgroundColor="White" Stroke="#E3E9F1"
                StrokeShape="RoundRectangle 12" Padding="15">
          <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="▣  硬件扫码诊断" Style="{StaticResource SectionTitle}"/>
              <Label Grid.Column="1" x:Name="ScannerStatusText"
                     Text="等待硬件扫描" FontSize="11" TextColor="#7F91AA"
                     VerticalOptions="Center"/>
            </Grid>
            <Label x:Name="ScannerActionText" Text="广播：com.service.scanner.data"
                   FontSize="12" TextColor="#61738D"
                   LineBreakMode="CharacterWrap"/>
            <Label x:Name="ScannerExtraText" Text="字段：ScanCode"
                   FontSize="12" TextColor="#61738D"/>
            <Label Text="扫码广播 Action（不同机型可修改）"
                   TextColor="#536581" FontSize="12"/>
            <Border Stroke="#DCE4EF" StrokeShape="RoundRectangle 9" Padding="8,0">
              <Entry x:Name="ScannerActionInput"
                     Placeholder="com.service.scanner.data"
                     FontSize="12" HeightRequest="45"
                     BackgroundColor="Transparent"/>
            </Border>
            <Label Text="扫码字符串 Extra 字段名"
                   TextColor="#536581" FontSize="12"/>
            <Border Stroke="#DCE4EF" StrokeShape="RoundRectangle 9" Padding="8,0">
              <Entry x:Name="ScannerExtraInput"
                     Placeholder="ScanCode"
                     FontSize="12" HeightRequest="45"
                     BackgroundColor="Transparent"/>
            </Border>
            <Button Text="应用扫码参数（即时生效）"
                    Style="{StaticResource SecondaryAction}"
                    Clicked="SaveScanner_Clicked"/>
            <Border BackgroundColor="#F5F8FE" Stroke="#E2EAF7"
                    StrokeShape="RoundRectangle 9" Padding="12,11">
              <VerticalStackLayout Spacing="5">
                <Label Text="最近一次扫码接收情况"
                       TextColor="#637793" FontSize="11"/>
                <Label x:Name="LastScanText" Text="尚未收到扫码广播"
                       FontSize="13" FontAttributes="Bold" TextColor="#324969"
                       LineBreakMode="WordWrap"/>
              </VerticalStackLayout>
            </Border>
            <Label Text="在此页面按 PDA 的实体扫码键，观察接收状态。正常作业仅保留时间和长度；在此页扫码才生成 ID 前缀、分隔符数量和不可见字符位置；不显示、不上传、不记录箱码原文。广播 Action/字段仍需按具体海康设备核验。"
                   FontSize="11" TextColor="#72829C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="White" Stroke="#E3E9F1" StrokeShape="RoundRectangle 12" Padding="15">
          <VerticalStackLayout Spacing="8">
            <Label Text="扫码声音与震动" Style="{StaticResource SectionTitle}"/>
            <Label Text="业务反馈独立于硬件读码音。设置立即保存，不影响连接或盘点草稿。" Style="{StaticResource SecondaryText}"/>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
              <Label Text="启用声音反馈" VerticalOptions="Center" FontSize="13"/>
              <Switch Grid.Column="1" x:Name="SoundSwitch" Toggled="Feedback_Toggled" VerticalOptions="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
              <Label Text="启用震动反馈" VerticalOptions="Center" FontSize="13"/>
              <Switch Grid.Column="1" x:Name="VibrationSwitch" Toggled="Feedback_Toggled" VerticalOptions="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
              <Label Text="业务成功反馈 · 200 ms" VerticalOptions="Center" FontSize="13"/>
              <Switch Grid.Column="1" x:Name="SuccessFeedbackSwitch" Toggled="Feedback_Toggled" VerticalOptions="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
              <Label Text="业务失败/待确认 · 1000 ms" VerticalOptions="Center" FontSize="13"/>
              <Switch Grid.Column="1" x:Name="FailureFeedbackSwitch" Toggled="Feedback_Toggled" VerticalOptions="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
              <Label Text="额外扫码读取音（默认关闭）" VerticalOptions="Center" FontSize="13"/>
              <Switch Grid.Column="1" x:Name="ReadFeedbackSwitch" Toggled="Feedback_Toggled" VerticalOptions="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button x:Name="PreviewSuccessButton" Text="试听成功" Clicked="PreviewSuccess_Clicked" Style="{StaticResource SecondaryAction}"/>
              <Button Grid.Column="1" x:Name="PreviewFailureButton" Text="试听失败" Clicked="PreviewFailure_Clicked" Style="{StaticResource SecondaryAction}"/>
            </Grid>
            <Label x:Name="FeedbackSettingsStatus" Text="试听遵循当前声音与震动开关；不会发送请求。" Style="{StaticResource SecondaryText}"/>
          </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="White" Stroke="#E3E9F1" StrokeShape="RoundRectangle 12" Padding="15">
          <VerticalStackLayout Spacing="8">
            <Label Text="客户端性能诊断" Style="{StaticResource SectionTitle}"/>
            <Label Text="最近512个阶段耗时，仅内存保留；不记录箱码、数量或密钥。" Style="{StaticResource SecondaryText}"/>
            <Label x:Name="PerformanceText" Text="点击刷新查看采样" FontSize="12" LineBreakMode="WordWrap"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Button Text="刷新" Clicked="RefreshPerformance_Clicked" Style="{StaticResource SecondaryAction}"/>
              <Button Grid.Column="1" Text="复制" Clicked="CopyPerformance_Clicked" Style="{StaticResource SecondaryAction}"/>
              <Button Grid.Column="2" Text="清空" Clicked="ClearPerformance_Clicked" Style="{StaticResource SecondaryAction}"/>
            </Grid>
          </VerticalStackLayout>
        </Border>
        <Border BackgroundColor="#EEF3FB" Stroke="#E1E9F6"
                StrokeShape="RoundRectangle 10" Padding="13">
          <VerticalStackLayout Spacing="7">
            <Label Text="安全说明" FontAttributes="Bold"
                   TextColor="#496485" FontSize="13"/>
            <Label Text="可信隔离局域网免密模式只需 API 地址和帐套；旧版服务可选密钥。数据库账号密码仅在 Windows 管理器配置。"
                   FontSize="12" TextColor="#647A9C"/>
            <Label Text="已提交但响应丢失时，原单据、数量和 UUID 会加密保存；确认结果之前，不允许切换服务器或帐套。"
                   FontSize="12" TextColor="#647A9C"/>
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>
    </ScrollView>

    <Border Grid.Row="2" BackgroundColor="White"
            Stroke="#E3E9F1" Padding="14,12,14,15">
      <Button x:Name="SaveButton" Text="✓  保存设置"
              Style="{StaticResource PrimaryAction}"
              Clicked="Save_Clicked"/>
    </Border>
  </Grid>
</ContentPage>