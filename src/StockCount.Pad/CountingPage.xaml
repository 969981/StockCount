<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockCount.Pad.CountingPage"
             NavigationPage.HasNavigationBar="False"
             Title="扫码盘点" BackgroundColor="White" SafeAreaEdges="All">
  <!-- IME Resize + MAUI 10 safe area: only the star-sized detail area scrolls; environment and current location stay visible.
       Quantity and submit are siblings of the ScrollView, never inside it. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">
    <Grid Grid.Row="0" RowDefinitions="48,1" ColumnDefinitions="44,*,Auto" BackgroundColor="White">
      <Button Text="‹" FontSize="27" Padding="0" BackgroundColor="Transparent"
              TextColor="#263645" Clicked="Back_Clicked"
              SemanticProperties.Description="返回盘点单列表"/>
      <Label Grid.Column="1" Text="扫码盘点" FontSize="18" FontAttributes="Bold"
             TextColor="#17232F" VerticalOptions="Center"/>
      <Button Grid.Column="2" x:Name="HistoryButton" IsVisible="False" Text="▤ 已盘记录" FontSize="13" Padding="12,0"
              BackgroundColor="Transparent" TextColor="#263645" Clicked="History_Clicked"
              SemanticProperties.Description="打开当前单的已盘记录"/>
      <BoxView Grid.Row="1" Grid.ColumnSpan="3" Color="#D9DFE5"/>
    </Grid>
    <VerticalStackLayout Grid.Row="1" Spacing="0">
        <Border x:Name="EnvironmentBanner" BackgroundColor="#F0F4F9"
                Stroke="#DCE3EA" StrokeThickness="0" Padding="10,3" MinimumHeightRequest="25">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Label x:Name="EnvironmentLabel" Text="测试 · XTEST" TextColor="#31537C"
                   FontAttributes="Bold" FontSize="12" VerticalOptions="Center"/>
            <Label x:Name="ConnectionStateText" Grid.Column="1" Text="等待扫码"
                   TextColor="#627181" FontSize="12" HorizontalTextAlignment="End"
                   VerticalOptions="Center" LineBreakMode="WordWrap"/>
          </Grid>
        </Border>
        <BoxView Color="#DCE3EA" HeightRequest="1"/>
        <Border x:Name="LocationCard" BackgroundColor="#F5F8FB" StrokeThickness="0" Padding="10,4">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="1">
            <Label Text="盘点库位" FontSize="12" FontAttributes="Bold" TextColor="#44515F" VerticalOptions="Center"/>
            <Label x:Name="LocationText" Grid.Column="1" Text="—" FontSize="18"
                   FontAttributes="Bold" TextColor="#154A87" LineBreakMode="CharacterWrap" VerticalOptions="Center"
                   SemanticProperties.Description="当前盘点库位，只能通过扫描修改"/>
            <Label x:Name="LocationStatusText" Grid.Column="2" Text="未扫描" FontSize="11"
                   TextColor="#667687" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label x:Name="LocationHintText" Grid.Row="1" Grid.ColumnSpan="3" Text="请扫描库位"
                   TextColor="#667687" FontSize="10" HorizontalTextAlignment="End"/>
          </Grid>
        </Border>
        <BoxView Color="#CDD7E0" HeightRequest="1"/>
    </VerticalStackLayout>
    <ScrollView Grid.Row="2" x:Name="CountDetailsScroll" VerticalScrollBarVisibility="Default"
                VerticalOptions="Fill" MinimumHeightRequest="0" SizeChanged="DetailsViewport_SizeChanged">
      <VerticalStackLayout Spacing="0" SizeChanged="DetailsViewport_SizeChanged">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10"
              RowSpacing="4" Padding="10,5,10,6">
          <Label x:Name="CountNumberText" FontSize="15" FontAttributes="Bold"
                 TextColor="#17232F" LineBreakMode="CharacterWrap"/>
          <Label x:Name="PermissionText" Grid.Column="1" FontSize="11" TextColor="#276C43"
                 VerticalOptions="Center" HorizontalTextAlignment="End"/>
          <Label x:Name="CountNameText" Grid.Row="1" FontSize="13" TextColor="#17232F"
                 LineBreakMode="WordWrap" VerticalOptions="Center"/>
          <Label x:Name="WarehouseText" Grid.Row="1" Grid.Column="1" FontSize="12"
                 TextColor="#627181" HorizontalTextAlignment="End" VerticalOptions="Center"/>
        </Grid>
        <BoxView Color="#D7DDE3" HeightRequest="1"/>
        <Grid ColumnDefinitions="*,Auto" Padding="10,6,10,5">
          <Label Text="当前箱信息" FontSize="14" FontAttributes="Bold" TextColor="#17232F"/>
          <Label x:Name="BoxStateText" Grid.Column="1" Text="等待扫码"
                 FontSize="12" TextColor="#627181" VerticalOptions="Center"/>
        </Grid>
        <BoxView Color="#E0E5E9" HeightRequest="1"/>
        <Border x:Name="ConflictCard" IsVisible="False" BackgroundColor="#FCEAEA"
                Stroke="#EAC5C5" StrokeShape="RoundRectangle 6" Margin="10,4" Padding="10,8">
          <VerticalStackLayout Spacing="4">
            <Label x:Name="ConflictTitle" Text="原盘点记录冲突" TextColor="#A93232" FontSize="14" FontAttributes="Bold"/>
            <Label x:Name="ConflictDetails" TextColor="#805555" FontSize="13" LineBreakMode="WordWrap"/>
            <Label Text="禁止提交。核对原记录后重新扫码。" TextColor="#A93232" FontSize="12"/>
          </VerticalStackLayout>
        </Border>
        <VerticalStackLayout x:Name="BoxEmptyPanel" Padding="10,14" Spacing="6">
          <Label x:Name="BoxEmptyTitleText" Text="请先扫描库位" FontSize="15"
                 FontAttributes="Bold" TextColor="#364655" HorizontalTextAlignment="Center"/>
          <Label x:Name="BoxEmptyHintText" Text="使用 PDA 实体扫码键" FontSize="13"
                 TextColor="#6B7885" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="BoxFields" IsVisible="False" Padding="10,0" Spacing="0">
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="箱码" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="BoxNumberText" FontSize="13" TextColor="#17232F" FontAttributes="Bold"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
            <BoxView Color="#EDF0F2" HeightRequest="1"/>
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="产品编码" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="ItemCodeText" FontSize="13" TextColor="#17232F" FontAttributes="Bold"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
            <BoxView Color="#EDF0F2" HeightRequest="1"/>
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="品名" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="ItemNameText" FontSize="13" TextColor="#17232F"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
            <BoxView Color="#EDF0F2" HeightRequest="1"/>
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="规格" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="SpecificationText" FontSize="13" TextColor="#17232F"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
            <BoxView Color="#EDF0F2" HeightRequest="1"/>
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="批号" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="LotText" FontSize="13" TextColor="#17232F"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
            <BoxView Color="#EDF0F2" HeightRequest="1"/>
            <Grid ColumnDefinitions="72,*" ColumnSpacing="8" Padding="0,4" MinimumHeightRequest="28">
              <Label Text="存货单位" FontSize="13" TextColor="#687685" VerticalOptions="Start"/>
              <Label Grid.Column="1" x:Name="StockUnitText" FontSize="13" TextColor="#17232F"
                     LineBreakMode="CharacterWrap" VerticalOptions="Start"/>
            </Grid>
        </VerticalStackLayout>
        <Border x:Name="ReadOnlyWarning" IsVisible="False" Padding="12,8"
                BackgroundColor="#FFF5E6" StrokeThickness="0">
          <Label x:Name="ReadOnlyText" Text="当前盘点单尚未获准提交"
                 TextColor="#9B5C11" FontSize="12"/>
        </Border>
      </VerticalStackLayout>
    </ScrollView>
    <Border x:Name="PendingPanel" Grid.Row="3" IsVisible="False"
            BackgroundColor="#FFF5E6" Stroke="#F3DEBA"
            Padding="13,10">
      <VerticalStackLayout Spacing="8">
        <Label Text="⚠ 提交结果待确认" TextColor="#9B5C11"
               FontSize="13" FontAttributes="Bold"/>
        <Label Text="原请求编号与数量已安全保留。请先查询结果；重试时仍使用原 UUID。"
               FontSize="11" TextColor="#88622B"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
          <Button Grid.Column="0" x:Name="CheckButton" Text="检查提交结果"
                  Style="{StaticResource SecondaryAction}" Clicked="Check_Clicked"/>
          <Button Grid.Column="1" x:Name="RetryButton" Text="重试原提交"
                  Style="{StaticResource SecondaryAction}" Clicked="Retry_Clicked"/>
        </Grid>
      </VerticalStackLayout>
    </Border>


    <Grid x:Name="QuantityActionBar" Grid.Row="4" RowDefinitions="1,Auto" BackgroundColor="White" SizeChanged="QuantityActionBar_SizeChanged">
      <BoxView Color="#CBD3DB"/>
      <Grid Grid.Row="1" Padding="10,4,10,5" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="0">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,0,0,3" ColumnSpacing="6">
          <Label x:Name="QuantityCaption" Text="箱内数量 *" FontSize="13" FontAttributes="Bold" TextColor="#17232F"/>
          <Label Grid.Column="1" x:Name="OriginalQuantityText" IsVisible="False" TextColor="#A46A15"
                 FontSize="12" HorizontalTextAlignment="End" LineBreakMode="CharacterWrap"/>
        </Grid>
        <!-- Use a single outline; let Android text metrics determine height.
             Clear and unit have independent columns so neither overlays the number. -->
        <Border x:Name="QuantityFrame" Grid.Row="1" Grid.ColumnSpan="2" Stroke="#8799AA" StrokeShape="RoundRectangle 4"
                BackgroundColor="White" Padding="6,0,0,0">
          <Grid ColumnDefinitions="*,48,Auto" ColumnSpacing="0" MinimumHeightRequest="48">
            <Entry x:Name="QuantityInput" Placeholder="输入数量" PlaceholderColor="#9AA5AF"
                   Keyboard="Numeric" FontSize="20" FontAttributes="Bold" TextColor="#172F4D"
                   MinimumHeightRequest="48" VerticalOptions="Fill" VerticalTextAlignment="Center"
                   BackgroundColor="Transparent" ClearButtonVisibility="Never"
                   HandlerChanged="QuantityInput_HandlerChanged"
                   Focused="QuantityInput_FocusChanged" Unfocused="QuantityInput_FocusChanged"
                   TextChanged="QuantityInput_TextChanged"/>
            <Button Grid.Column="1" x:Name="ClearQuantityButton" Text="×"
                    FontSize="19" TextColor="#536581" BackgroundColor="Transparent"
                    MinimumWidthRequest="48" MinimumHeightRequest="48"
                    Padding="0" CornerRadius="4" VerticalOptions="Center"
                    IsEnabled="False" Clicked="ClearQuantity_Clicked"
                    SemanticProperties.Description="清空箱内数量"/>
            <Grid Grid.Column="2" ColumnDefinitions="1,Auto" ColumnSpacing="0"
                  BackgroundColor="#F4F7FA" VerticalOptions="Fill">
              <BoxView Color="#D7DDE3" VerticalOptions="Fill"/>
              <Label Grid.Column="1" x:Name="QuantityUnitText" Text="—" FontSize="14"
                     TextColor="#617182" VerticalOptions="Center" HorizontalTextAlignment="Center"
                     MinimumWidthRequest="36" Padding="4,2"/>
            </Grid>
          </Grid>
        </Border>
        <Label x:Name="QuantityErrorText" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="False" FontSize="12"
               Text="箱内数量为必填项！" TextColor="#B33332"/>
        <Grid x:Name="SubmitAction" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
          <Button x:Name="SubmitButton" Text="提交盘点" FontSize="14" FontAttributes="Bold"
                  MinimumHeightRequest="48" CornerRadius="4" Padding="8,4" TextColor="White"
                  BackgroundColor="#175AB7" IsEnabled="False" Clicked="Submit_Clicked">
          </Button>
          <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                             InputTransparent="True" Color="#175AB7" WidthRequest="18"
                             HeightRequest="18" HorizontalOptions="End" Margin="0,0,12,0"
                             VerticalOptions="Center"/>
        </Grid>
      </Grid>
    </Grid>
    <!-- Compact, touch-through feedback. Never blocks the scanner or page. -->
    <Border x:Name="BusinessToast" Grid.RowSpan="5" ZIndex="100"
            IsVisible="False" InputTransparent="True"
            BackgroundColor="#287348" StrokeThickness="0"
            StrokeShape="RoundRectangle 9"
            HorizontalOptions="Fill" VerticalOptions="Center"
            MaximumWidthRequest="340" Margin="18,0" Padding="16,12">
      <VerticalStackLayout Spacing="4" InputTransparent="True">
        <Label x:Name="BusinessToastTitle" Text="✓ 盘点成功" TextColor="White"
               FontSize="13" FontAttributes="Bold" InputTransparent="True" HorizontalTextAlignment="Center"/>
        <Label x:Name="BusinessToastMessage" Text="提交成功！" TextColor="White" FontSize="16"
               FontAttributes="Bold" LineBreakMode="WordWrap"
               InputTransparent="True" HorizontalTextAlignment="Center"/>
      </VerticalStackLayout>
    </Border>
  </Grid>
</ContentPage>
