<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockCount.Pad.HistoryPage"
             NavigationPage.HasNavigationBar="False"
             Title="已盘记录" SafeAreaEdges="All"
             BackgroundColor="{StaticResource PageBackground}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" BackgroundColor="White" ColumnDefinitions="Auto,*,Auto"
          Padding="8,6,12,6" HeightRequest="60">
      <Button Text="‹" Style="{StaticResource IconButton}"
              Clicked="Back_Clicked"/>
      <Label Grid.Column="1" Text="已盘记录" Style="{StaticResource PageTitle}"
             Margin="6,0,0,0"/>
      <Button Grid.Column="2" Text="↻" Style="{StaticResource IconButton}"
              Clicked="Refresh_Clicked"/>
    </Grid>
    <VerticalStackLayout Grid.Row="1" Padding="14,12" Spacing="10">
      <Border x:Name="EnvironmentBanner" BackgroundColor="#EDF3FF"
              Stroke="#DCE8FF" StrokeShape="RoundRectangle 10" Padding="12,9">
        <Label x:Name="EnvironmentLabel" Text="测试 · XTEST"
               TextColor="#305CB6" FontAttributes="Bold" FontSize="13"/>
      </Border>
      <Border BackgroundColor="White" Stroke="#E5EAF1"
              StrokeShape="RoundRectangle 10" Padding="13,11">
        <VerticalStackLayout Spacing="5">
          <Label Text="当前盘点单 · 已盘箱记录" Style="{StaticResource SecondaryText}"/>
          <Label x:Name="CountNumberText" FontSize="15" FontAttributes="Bold"
                 TextColor="#1C2D48"/>
          <Label x:Name="CountNameText" FontSize="12" TextColor="#72829C"/>
          <Label x:Name="TotalStatusText" Text="已盘总记录：—" FontSize="16" FontAttributes="Bold" TextColor="#305CB6"/>
        </VerticalStackLayout>
      </Border>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
        <Entry x:Name="BoxSearchInput" Placeholder="搜索箱码" MaxLength="20" FontSize="13" MinimumHeightRequest="44"/>
        <Entry Grid.Column="1" x:Name="LocationFilterInput" Placeholder="库位（精确）" MaxLength="10" FontSize="13" MinimumHeightRequest="44"/>
        <Button Grid.Row="1" Text="查询 / 筛选" Clicked="Filter_Clicked" Style="{StaticResource SecondaryAction}"/>
        <Button Grid.Row="1" Grid.Column="1" Text="清空筛选" Clicked="ClearFilter_Clicked" Style="{StaticResource SecondaryAction}"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" Padding="3,5,3,0">
        <Label Text="已盘箱列表" Style="{StaticResource SectionTitle}"/>
        <Label Grid.Column="1" x:Name="CountStatusText"
               Text="正在读取" TextColor="#8493A8" FontSize="12"/>
      </Grid>
    </VerticalStackLayout>
    <Grid Grid.Row="2" Padding="14,0,14,0">
      <CollectionView x:Name="ItemsList" SelectionMode="None" RemainingItemsThreshold="-1"
                      RemainingItemsThresholdReached="ThresholdReached" ItemsUpdatingScrollMode="KeepScrollOffset">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border BackgroundColor="White" Stroke="#E3E9F1"
                    StrokeShape="RoundRectangle 12" Padding="14"
                    Margin="0,0,0,10">
              <VerticalStackLayout Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="{Binding BoxNumber}" FontSize="15"
                         FontAttributes="Bold" TextColor="#1C2D48"
                         LineBreakMode="MiddleTruncation"/>
                  <Label Grid.Column="1" Text="{Binding StatusText}"
                         BackgroundColor="#E8F6EE" TextColor="#19805B"
                         FontSize="11" FontAttributes="Bold" Padding="7,3"/>
                </Grid>
                <!-- Timestamp shares the location row, not the variable-length quantity row. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Label Text="{Binding LocationCode, StringFormat='库位：{0}'}"
                         FontSize="12" TextColor="#72829C"
                         LineBreakMode="CharacterWrap" VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="{Binding CreatedAt, StringFormat='{0:MM-dd HH:mm}'}"
                         FontSize="11" TextColor="#8B9CB2"
                         VerticalOptions="Center"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                  <Label Text="实盘：" TextColor="#72829C" FontSize="12"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1" Text="{Binding QuantityText}" FontSize="16"
                         FontAttributes="Bold" TextColor="#376BEE"
                         LineBreakMode="CharacterWrap" VerticalOptions="Center"/>
                </Grid>
                <Label Text="{Binding CorrectionText}" IsVisible="{Binding HasCorrection}"
                       TextColor="#A46A15" FontSize="12" LineBreakMode="WordWrap"/>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
      <VerticalStackLayout x:Name="EmptyPanel" IsVisible="False"
                           VerticalOptions="Center" Spacing="10">
        <Label Text="▤" FontSize="44" TextColor="#9EB0C9"
               HorizontalOptions="Center"/>
        <Label x:Name="EmptyText" Text="暂无已盘记录"
               HorizontalOptions="Center" TextColor="#63738A"
               FontSize="14"/>
      </VerticalStackLayout>
      <ActivityIndicator x:Name="LoadingIndicator"
                         Color="{StaticResource Primary}"
                         IsVisible="False" VerticalOptions="Center"
                         HorizontalOptions="Center"/>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="14,10,14,15">
      <VerticalStackLayout VerticalOptions="Center" Spacing="2">
        <Label x:Name="FooterStatus" Text="正在读取" FontSize="11" TextColor="#627181"/>
        <Label Text="只读记录 · 不支持修改或删除" FontSize="11" TextColor="#8C9CB2"/>
      </VerticalStackLayout>
      <Button x:Name="MoreButton" Grid.Column="1" Text="加载更多"
              IsVisible="False" Style="{StaticResource SecondaryAction}"
              Clicked="More_Clicked"/>
    </Grid>
  </Grid>
</ContentPage>
