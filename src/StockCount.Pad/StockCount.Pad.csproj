<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>StockCount</ApplicationTitle>
    <ApplicationId>com.dreamer.stockcount.pad</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit dependency required by .NET MAUI 8+; match the installed workload. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../StockCount.Core/StockCount.Core.csproj" />
    <ProjectReference Include="../StockCount.Contracts/StockCount.Contracts.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg"
              ForegroundFile="Resources/AppIcon/appiconfg.svg"
              ForegroundScale="0.75" Color="#1168E4" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#376BEE" BaseSize="128,128" />
    <!-- MAUI Android native raw resources (not MauiAsset). -->
    <AndroidResource Remove="Platforms/Android/Resources/raw/scan_*.wav;Platforms/Android/Resources/raw/scan_*.ogg" />
    <AndroidResource Include="Platforms/Android/Resources/raw/scan_success.ogg;Platforms/Android/Resources/raw/scan_failure.ogg;Platforms/Android/Resources/raw/scan_read.wav;Platforms/Android/Resources/raw/scan_success_g05.wav;Platforms/Android/Resources/raw/scan_success_g06.wav;Platforms/Android/Resources/raw/scan_success_g07.wav;Platforms/Android/Resources/raw/scan_success_g08.wav;Platforms/Android/Resources/raw/scan_success_g09.wav;Platforms/Android/Resources/raw/scan_success_g10.wav;Platforms/Android/Resources/raw/scan_success_g11.wav;Platforms/Android/Resources/raw/scan_success_g12.wav;Platforms/Android/Resources/raw/scan_failure_g05.wav;Platforms/Android/Resources/raw/scan_failure_g06.wav;Platforms/Android/Resources/raw/scan_failure_g07.wav;Platforms/Android/Resources/raw/scan_failure_g08.wav;Platforms/Android/Resources/raw/scan_failure_g09.wav;Platforms/Android/Resources/raw/scan_failure_g10.wav;Platforms/Android/Resources/raw/scan_failure_g11.wav;Platforms/Android/Resources/raw/scan_failure_g12.wav" TargetPath="raw/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Generate from checked original OGGs before resource processing; no runtime encoder. -->
  <Target Name="PrepareFeedbackGainResources" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/generate-android-feedback-gain.ps1&quot;" />
  </Target>
</Project>
